{
  "name": "barbeariadojota",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "BARBEARIA", "class_name": "Barbearia" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Barbearia"] }]
}
